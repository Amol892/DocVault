# Copy to .env — works unedited for local development. Never commit .env.
#
# This file is written for tools running on YOUR machine (alembic, pytest, uvicorn), so the
# addresses use 127.0.0.1. Docker Compose overrides DATABASE_URL and S3_ENDPOINT_URL for the
# containers (host "db" / "storage" inside the compose network), so no second file is needed.
# To reach the database from your machine, publish its port with docker-compose.override.yml
# and run `docker compose up -d db`. The container is published on host port 5433, not 5432,
# so it cannot clash with a PostgreSQL that is installed on your machine.

# Postgres container (also used to build the container-side DATABASE_URL)
POSTGRES_USER=docvault
POSTGRES_PASSWORD=docvault
POSTGRES_DB=docvault

# API (host-side values; keep the user, password and database name in step with the three above)
DATABASE_URL=postgresql+asyncpg://docvault:docvault@127.0.0.1:5433/docvault
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docvault
# At least 32 characters; generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-any-real-environment
# Access-token lifetime in minutes (default 1440 = 24 h). There is no refresh flow.
# JWT_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=100
FRONTEND_URL=http://localhost:5173
