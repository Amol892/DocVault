# Copy to .env — works unedited for local development. Never commit .env.
#
# This file is written for tools running on YOUR machine (alembic, pytest, uvicorn), so the
# addresses use 127.0.0.1. Docker Compose overrides DATABASE_URL and S3_ENDPOINT_URL for the
# containers (host "db" / "storage" inside the compose network), so no second file is needed.
# To reach the database from your machine, publish its port with docker-compose.override.yml
# and run `docker compose up -d db`. The container is published on host port 5433, not 5432,
# so it cannot clash with a PostgreSQL that is installed on your machine.

# Postgres container (also used to build the container-side DATABASE_URL)
POSTGRES_USER=docvault
POSTGRES_PASSWORD=docvault
POSTGRES_DB=docvault

# API (host-side values; keep the user, password and database name in step with the three above)
DATABASE_URL=postgresql+asyncpg://docvault:docvault@127.0.0.1:5433/docvault
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
# Address the BROWSER can reach, for pre-signed upload/download URLs. Defaults to S3_ENDPOINT_URL;
# Docker Compose overrides both for the containers, so this file is for tools on your machine.
# --- Email (invitations, verification, password reset) ---
# Leave SMTP_HOST empty in development: emails are then written to the API log instead of sent
# (docker compose logs api). Set it to send real mail via any SMTP provider.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=DocVault <no-reply@example.com>
# SMTP_STARTTLS=true
# SMTP_SSL=false
#
# Example: Resend's SMTP relay (https://resend.com/docs/send-with-smtp). SMTP_USERNAME is
# literally "resend"; SMTP_PASSWORD is your Resend API key. SMTP_FROM's domain must be verified
# in the Resend dashboard, or use onboarding@resend.dev (deliverable only to your own account)
# until it is.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_your_resend_api_key
# SMTP_FROM=DocVault <you@yourverifieddomain.com>
# SMTP_STARTTLS=true
# SMTP_SSL=false
#
# Example: Gmail. Needs 2-Step Verification turned on and an App Password generated at
# https://myaccount.google.com/apppasswords (your normal Gmail password will not work here).
# SMTP_FROM must be the same address you authenticate as (or a verified "Send mail as" alias),
# or Gmail rejects or rewrites it. Capped at 500 messages/day on a regular account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your16charapppassword
# SMTP_FROM=DocVault <youraddress@gmail.com>
# SMTP_STARTTLS=true
# SMTP_SSL=false
# INVITE_EXPIRE_DAYS=7

# --- Accounts and housekeeping ---
# New accounts must confirm their email before using the API (FR-1). With SMTP_HOST empty, the
# confirmation link appears in the API log (docker compose logs api). Set to false to skip it.
# REQUIRE_EMAIL_VERIFICATION=true
# Deleted documents stay restorable this long; unconfirmed uploads are abandoned after this many hours.
# TRASH_GRACE_DAYS=30
# PENDING_UPLOAD_TTL_HOURS=24

# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docvault
# At least 32 characters; generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-any-real-environment
# Access-token lifetime in minutes (default 1440 = 24 h). There is no refresh flow.
# JWT_EXPIRE_MINUTES=1440
MAX_UPLOAD_MB=100
FRONTEND_URL=http://localhost:5173
