# Optional. Copy to frontend/.env to override the defaults below. Never commit .env.

# Base URL the client calls for the API. Default: /api/v1, which the Vite dev server proxies
# to the API (vite.config.ts; target from API_PROXY_TARGET, default http://localhost:8000).
# In production, serve the app behind a reverse proxy that forwards /api to the API.
VITE_API_BASE_URL=/api/v1

# Upload size limit shown and enforced in the UI, in MB. Keep it equal to the API's
# MAX_UPLOAD_MB (root .env). PRD FR-5 default: 100.
VITE_MAX_UPLOAD_MB=100
