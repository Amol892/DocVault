# Copy to docker-compose.override.yml for local development (never for production).
services:
  storage:
    ports:
      - "9001:9001" # MinIO console

  db:
    ports:
      # Host port 5433 (not 5432) so it cannot clash with a PostgreSQL installed on the host,
      # which would silently receive the connections instead of this container.
      - "5433:5432" # lets host-side alembic / pytest / psql reach the database

  api:
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
    volumes:
      - ./backend/app:/app/app

  frontend:
    volumes:
      - ./frontend/src:/app/src
